<?xml version='1.0' encoding='utf-8'?>
<!-- Layout for dashboard. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dmi_bg">

    <!-- dashboardScroll is referenced by the screen code when it renders or handles user input. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- HEADER -->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="28dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="MediFlow"
                        android:src="@drawable/logo_mediflow_wordmark" />

                </LinearLayout>

                <!-- searchButton lets the user narrow what is shown without changing the underlying medicine records. -->
                <ImageButton
                    android:id="@+id/searchButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search inventory"
                    android:src="@android:drawable/ic_menu_search"
                    android:visibility="gone"
                    app:tint="@color/dmi_accent" />

                <ImageButton
                    android:id="@+id/alertsButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Alerts"
                    android:src="@android:drawable/ic_dialog_alert"
                    android:visibility="gone"
                    app:tint="@color/dmi_accent" />

                <TextView
                    android:id="@+id/profileInitials"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_profile_circle"
                    android:gravity="center"
                    android:text="--"
                    android:textColor="@color/dmi_primary"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- GREETING -->

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Welcome"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Here is your medication inventory update."
                android:textColor="@color/dmi_text_secondary"
                android:textSize="13sp" />

            <!-- SUMMARY CARDS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Total medicines -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/totalMedicinesCard"
                        android:layout_width="128dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/dmi_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_indicator_pill"
                                android:backgroundTint="@color/dmi_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Medicines"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/totalMedicinesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Low stock -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/lowStockCard"
                        android:layout_width="128dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/dmi_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_indicator_pill"
                                android:backgroundTint="@color/dmi_warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Low Stock"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/lowStockValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0"
                                android:textColor="@color/dmi_warning"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Near expiry -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/nearExpiryCard"
                        android:layout_width="128dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/dmi_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_indicator_pill"
                                android:backgroundTint="@color/dmi_warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Near Expiry"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/nearExpiryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0"
                                android:textColor="@color/dmi_warning"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Active alerts -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/activeAlertsCard"
                        android:layout_width="128dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/dmi_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_indicator_pill"
                                android:backgroundTint="@color/dmi_danger" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Alerts"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/activeAlertsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0"
                                android:textColor="@color/dmi_danger"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Pending sync -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/pendingSyncCard"
                        android:layout_width="128dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/dmi_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_indicator_pill"
                                android:backgroundTint="@color/dmi_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending Sync"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/pendingSyncValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0"
                                android:textColor="@color/dmi_accent_dark"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Conflict / rejected -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/syncAttentionCard"
                        android:layout_width="128dp"
                        android:layout_height="100dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/dmi_divider"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="4dp"
                                android:layout_marginBottom="8dp"
                                android:background="@drawable/bg_indicator_pill"
                                android:backgroundTint="@color/dmi_danger" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Needs Review"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/syncAttentionValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="0"
                                android:textColor="@color/dmi_danger"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>
            <!-- DATA FRESHNESS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/syncFreshnessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dmi_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data freshness"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lastSyncText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="No successful inventory sync recorded yet"
                        android:textColor="@color/dmi_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Dashboard values are based on locally available Room data."
                        android:textColor="@color/dmi_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- STOCK OVERVIEW -->
            <LinearLayout
                android:id="@+id/stockOverviewSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stock Overview"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/viewAllStock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="View All"
                        android:textColor="@color/dmi_accent_dark"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dmi_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/stockLowText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 medicines require reorder"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/stockNearExpiryRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/stockNearExpiryText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0 near-expiry alerts"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/stockExpiredRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/stockExpiredText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0 expired-stock alerts"
                                android:textColor="@color/dmi_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!-- CRITICAL EXPIRY -->
            <LinearLayout
                android:id="@+id/criticalExpirySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Critical Expiry Alerts"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/criticalExpiryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dmi_danger"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/criticalExpiryTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No critical expiry alerts"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/criticalExpiryDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="There are currently no unresolved near-expiry or expired-stock alerts."
                            android:textColor="@color/dmi_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!-- RECENT MOVEMENT -->
            <LinearLayout
                android:id="@+id/recentMovementSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Movement"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/recentMovementContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dmi_divider"
                    app:strokeWidth="1dp">

                    <!-- recentMovementEmpty gives the user feedback when there is no content or an operation cannot complete. -->
                    <TextView
                        android:id="@+id/recentMovementEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="No inventory movement recorded yet."
                        android:textColor="@color/dmi_text_secondary" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- bottomNavigation belongs to this screen's navigation rather than its inventory calculations. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_surface"
        android:elevation="8dp"
        app:itemIconTint="@color/dmi_bottom_nav_tint"
        app:itemTextColor="@color/dmi_bottom_nav_tint"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/dashboard_bottom_navigation" />
</androidx.constraintlayout.widget.ConstraintLayout>