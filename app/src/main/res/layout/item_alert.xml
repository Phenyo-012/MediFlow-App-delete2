<?xml version='1.0' encoding='utf-8'?>
<!-- Layout for alert. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- alertTypeText is referenced by the screen code when it renders or handles user input. -->
            <TextView
                android:id="@+id/alertTypeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOW STOCK"
                android:textColor="#172033"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alertSeverityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="#B42318"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/alertMedicineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Paracetamol · PAR500"
            android:textColor="#25364D"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertBatchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Batch: B001"
            android:textColor="#738096"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alertMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#4E5969"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- alertStatusText reflects the latest state returned to the screen. -->
            <TextView
                android:id="@+id/alertStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACTIVE"
                android:textColor="#738096"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View details  ›"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alertAcknowledgeButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Acknowledge"
            android:textColor="@color/dmi_outlined_text"
            android:visibility="gone"
            app:strokeColor="@color/dmi_outlined_stroke" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
