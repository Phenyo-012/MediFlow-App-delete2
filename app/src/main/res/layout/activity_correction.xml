<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for correction. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- correctionHeader is referenced by the screen code when it renders or handles user input. -->
    <LinearLayout
        android:id="@+id/correctionHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/correctionBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_button"
            android:scaleType="fitCenter"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stock Correction"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/correctionHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medicine"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/correctionMedicineNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Original Confirmed Movement"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select the exact confirmed movement that this correction relates to."
                android:textColor="#738096"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectCorrectionOriginalButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Select Original Movement"
                android:textColor="@color/dmi_accent_dark"
                app:backgroundTint="@android:color/white"
                app:strokeColor="@color/dmi_accent"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/correctionOriginalDetailsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#EAF3FC"
                android:padding="12dp"
                android:textColor="#355675"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Correction Direction"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/correctionDirectionGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/correctionIncreaseRadio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/dmi_accent"
                    android:text="Increase"
                    android:textColor="#172033" />

                <RadioButton
                    android:id="@+id/correctionDecreaseRadio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/dmi_accent"
                    android:text="Decrease"
                    android:textColor="#172033" />

            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Correction quantity"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/dmi_accent"
                app:hintTextColor="@color/dmi_accent_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/correctionQuantityInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Explanatory reason"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/dmi_accent"
                app:hintTextColor="@color/dmi_accent_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/correctionReasonInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minLines="3" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- correctionProgress communicates that the screen is waiting for data or a submitted action. -->
            <ProgressBar
                android:id="@+id/correctionProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/dmi_accent"
                android:visibility="gone" />

            <!-- confirmCorrectionButton starts a user-requested change; the ViewModel or repository remains responsible for validation. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmCorrectionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:enabled="false"
                android:text="Confirm Correction"
                android:textColor="@color/correction_confirm_text"
                app:backgroundTint="@color/correction_confirm_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="The original confirmed movement is never edited. This creates a new linked correction movement."
                android:textColor="#738096"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
