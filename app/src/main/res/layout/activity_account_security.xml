<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for account security. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Teal header -->
    <!-- totpHeader is referenced by the screen code when it renders or handles user input. -->
    <LinearLayout
        android:id="@+id/totpHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Account Security"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:text="Manage your account protection"
            android:textColor="#E9F3FD"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/totpContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toBottomOf="@id/totpHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Section heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Two-Factor Authentication"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Protect your MediFlow account with an authenticator app. Setup requires an internet connection."
                android:textColor="#738096"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <!-- Main security card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="@color/dmi_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Security status -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Security Status"
                        android:textColor="@color/dmi_accent_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- totpProgress communicates that the screen is waiting for data or a submitted action. -->
                    <ProgressBar
                        android:id="@+id/totpProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:indeterminateTint="@color/dmi_accent" />

                    <!-- totpStatus reflects the latest state returned to the screen. -->
                    <TextView
                        android:id="@+id/totpStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Checking your account..."
                        android:textColor="#243B53"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />

                    <!-- Email verification -->
                    <LinearLayout
                        android:id="@+id/totpVerifyEmailPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Verify Your Email"
                            android:textColor="@color/dmi_accent_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="You must verify your email address before enrolling an authenticator. Check the message from Firebase, then return here."
                            android:textColor="#53647B"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/totpSendEmailButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:minHeight="48dp"
                            android:text="Send verification email"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="@color/dmi_primary"
                            app:cornerRadius="50dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/totpRecheckEmailButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:text="I've verified my email — check again"
                            android:textAllCaps="false"
                            android:textColor="@color/dmi_primary"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="50dp"
                            app:strokeColor="@color/dmi_accent"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                    <!-- Password confirmation -->
                    <LinearLayout
                        android:id="@+id/totpPasswordPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Confirm Your Identity"
                            android:textColor="@color/dmi_accent_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Confirm your password to begin secure enrollment."
                            android:textColor="#53647B"
                            android:textSize="13sp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/totpPasswordLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Current password"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/totpPasswordInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/totpBeginButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:minHeight="48dp"
                            android:text="Verify password and begin setup"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="@color/dmi_primary"
                            app:cornerRadius="50dp" />

                    </LinearLayout>

                    <!-- TOTP enrollment -->
                    <LinearLayout
                        android:id="@+id/totpEnrollmentPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Set Up Authenticator"
                            android:textColor="@color/dmi_accent_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="1. Scan this QR code with your authenticator app (or enter the setup key manually). Do not share it."
                            android:textColor="#243B53"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <!-- QR code -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="18dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeColor="@color/dmi_divider"
                            app:strokeWidth="1dp">

                            <ImageView
                                android:id="@+id/totpQrImage"
                                android:layout_width="240dp"
                                android:layout_height="240dp"
                                android:padding="8dp"
                                android:background="#FFFFFF"
                                android:contentDescription="Authenticator enrollment QR code"
                                android:scaleType="fitCenter" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Manual Setup Key (Private)"
                            android:textColor="@color/dmi_accent_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/totpSetupKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:breakStrategy="simple"
                            android:textIsSelectable="false"
                            android:textColor="#132238"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:background="@color/dmi_accent_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/totpOpenAppButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:minHeight="48dp"
                            android:text="Open authenticator app on this device"
                            android:textAllCaps="false"
                            android:textColor="@color/dmi_outlined_text"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="50dp"
                            app:strokeColor="@color/dmi_outlined_stroke"
                            app:strokeWidth="1dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="20dp"
                            android:background="@color/dmi_divider" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Verify Authenticator Code"
                            android:textColor="@color/dmi_accent_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="2. Enter the current six-digit code generated by your authenticator app to finish enrollment."
                            android:textColor="#243B53"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/totpCodeLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Six-digit authenticator code"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/totpCodeInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="6" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- totpConfirmButton starts a user-requested change; the ViewModel or repository remains responsible for validation. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/totpConfirmButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:minHeight="48dp"
                            android:text="Enable two-factor authentication"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="@color/dmi_primary"
                            app:cornerRadius="50dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/totpCancelButton"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:text="Cancel setup"
                            android:textAllCaps="false"
                            android:textColor="@color/dmi_outlined_text"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="50dp"
                            app:strokeColor="@color/dmi_outlined_stroke"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/totpBackButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="Back to More"
                android:textAllCaps="false"
                android:textColor="@color/dmi_outlined_text"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="50dp"
                app:strokeColor="@color/dmi_outlined_stroke"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
