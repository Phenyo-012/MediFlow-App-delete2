<?xml version='1.0' encoding='utf-8'?>
<!-- Receipt entry screen for new batches and explicit top-ups to an existing batch. The Activity switches the visible batch controls by mode, validates scanned suggestions with the user, and shows a pending state after local queueing; server confirmation happens later. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- Header remains visible above the scrollable receipt form and provides the back navigation action. -->
    <LinearLayout
        android:id="@+id/receiveStockHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_button"
            app:tint="@android:color/white"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Receive Stock"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/receiptFormScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/receiveStockHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/dmi_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEDICINE"
                        android:textColor="@color/dmi_accent_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/medicineNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Loading medicine..."
                        android:textColor="@color/dmi_accent_dark"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/medicineCodeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#738096"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanReceiptBarcodeButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Scan / Verify Package Barcode"
                        android:textColor="@color/dmi_outlined_text"
                        app:strokeColor="@color/dmi_outlined_stroke" />

                    <!-- receiptScanStatusText reflects the latest state returned to the screen. -->
                    <TextView
                        android:id="@+id/receiptScanStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#405067"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/dmi_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECEIPT INFORMATION"
                        android:textColor="@color/dmi_accent_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- The explicit mode separates creating a lot from topping up a selected lot. -->
                    <RadioGroup
                        android:id="@+id/receiptModeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:checkedButton="@id/createNewBatchRadio">
                        <RadioButton
                            android:id="@+id/createNewBatchRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Create new batch" />
                        <RadioButton
                            android:id="@+id/receiveExistingBatchRadio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Receive into existing batch" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/existingBatchLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Select existing batch"
                        android:visibility="gone"
                        app:boxStrokeColor="@color/dmi_input_stroke"
                        app:hintTextColor="@color/dmi_input_hint">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/existingBatchInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/batchNumberLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Batch Number"
                        app:boxStrokeColor="@color/dmi_input_stroke"
                        app:hintTextColor="@color/dmi_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/batchNumberInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/quantityLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Quantity Received"
                        app:boxStrokeColor="@color/dmi_input_stroke"
                        app:hintTextColor="@color/dmi_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/quantityInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/receivedDateLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Received Date"
                        app:boxStrokeColor="@color/dmi_input_stroke"
                        app:hintTextColor="@color/dmi_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/receivedDateInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/expiryDateLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Expiry Date"
                        app:boxStrokeColor="@color/dmi_input_stroke"
                        app:hintTextColor="@color/dmi_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/expiryDateInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Displays validation or save errors without changing the values already entered in the receipt form. -->
            <TextView
                android:id="@+id/formErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <!-- Shown while medicine or batch data loads and while the receipt action is being saved. -->
            <ProgressBar
                android:id="@+id/receiptProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/dmi_accent"
                android:progressTint="@color/dmi_accent"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reviewReceiptButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="Review Receipt"
                android:textColor="@color/dmi_primary_button_text"
                app:backgroundTint="@color/dmi_primary_button_background" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Separates a locally queued receipt from the editable form while sync is pending. -->
    <LinearLayout
        android:id="@+id/pendingStateContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/receiveStockHeader">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receipt Pending"
            android:textColor="@color/dmi_accent_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pendingMessageText"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="The receipt was recorded locally and is waiting for synchronization."
            android:textColor="#738096"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pendingReferenceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#405067"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToMedicineButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Back to Medicine"
            android:textColor="@color/dmi_primary_button_text"
            app:backgroundTint="@color/dmi_primary_button_background" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
