<?xml version='1.0' encoding='utf-8'?>
<!-- Layout for bottom sheet notification preferences. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification preferences"
            android:textColor="@color/dmi_accent_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose which new inventory alerts can appear on this device. The Alerts screen always retains all alert records."
            android:textColor="#738096"
            android:textSize="13sp" />

        <!-- notificationMasterSwitch is referenced by the screen code when it renders or handles user input. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationMasterSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:checked="true"
            android:minHeight="48dp"
            android:text="Automatic notifications"
            android:textColor="#172033"
            android:textSize="15sp"
            app:thumbTint="@color/dmi_switch_thumb"
            app:trackTint="@color/dmi_switch_track" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E5EAF0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Alert types"
            android:textColor="#172033"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationLowStockSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="Low stock"
            android:textColor="#172033"
            app:thumbTint="@color/dmi_switch_thumb"
            app:trackTint="@color/dmi_switch_track" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationNearExpirySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="Near expiry"
            android:textColor="#172033"
            app:thumbTint="@color/dmi_switch_thumb"
            app:trackTint="@color/dmi_switch_track" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/notificationExpiredSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:minHeight="48dp"
            android:text="Expired stock"
            android:textColor="#172033"
            app:thumbTint="@color/dmi_switch_thumb"
            app:trackTint="@color/dmi_switch_track" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pausing a type hides its visible notifications without deleting inventory alerts or resetting notification history."
            android:textColor="#738096"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#E5EAF0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Device permissions"
            android:textColor="#172033"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- notificationDeviceStatus reflects the latest state returned to the screen. -->
        <TextView
            android:id="@+id/notificationDeviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Checking Android notification status…"
            android:textColor="#738096"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationDeviceAction"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Android settings"
            android:textColor="@color/dmi_outlined_text"
            app:strokeColor="@color/dmi_outlined_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send test notification"
            android:textColor="@color/dmi_primary_button_text"
            app:backgroundTint="@color/dmi_primary_button_background" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Test sends a generic preview only. It does not change your automatic-alert preferences."
            android:textColor="#738096"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationCloseButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Done"
            android:textColor="@color/dmi_outlined_text"
            app:strokeColor="@color/dmi_outlined_stroke" />
    </LinearLayout>
</ScrollView>
