<?xml version='1.0' encoding='utf-8'?>
<!-- Layout for reorder recommendations. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- reorderHeader is referenced by the screen code when it renders or handles user input. -->
    <LinearLayout
        android:id="@+id/reorderHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/reorderBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_button"
            app:tint="@android:color/white"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reorder Recommendations"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Medicines currently requiring replenishment"
                android:textColor="@color/dmi_accent_light"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/reorderLocalDataNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent_light"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:text="Based on locally available inventory. Synchronisation may update these recommendations."
        android:textColor="#3B5F75"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reorderHeader" />

    <!-- reorderProgress communicates that the screen is waiting for data or a submitted action. -->
    <ProgressBar
        android:id="@+id/reorderProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/dmi_accent"
        android:progressTint="@color/dmi_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reorderLocalDataNotice" />

    <!-- reorderRecyclerView displays the current rows; its adapter supplies the values and click behavior. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reorderRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reorderLocalDataNotice" />

    <!-- reorderEmptyState gives the user feedback when there is no content or an operation cannot complete. -->
    <LinearLayout
        android:id="@+id/reorderEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reorderLocalDataNotice">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No medicines require reorder"
            android:textColor="@color/dmi_accent_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Current usable stock is above the configured reorder levels."
            android:textColor="#738096"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reorderErrorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reorderLocalDataNotice">

        <TextView
            android:id="@+id/reorderErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Unable to calculate reorder recommendations."
            android:textColor="#B42318"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reorderRetryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Retry"
            android:textColor="@color/dmi_primary_button_text"
            app:backgroundTint="@color/dmi_primary_button_background" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
