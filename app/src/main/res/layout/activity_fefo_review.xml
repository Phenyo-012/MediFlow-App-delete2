<?xml version='1.0' encoding='utf-8'?>
<!-- Layout for first-expiry-first-out review. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- fefoHeader is referenced by the screen code when it renders or handles user input. -->
    <LinearLayout
        android:id="@+id/fefoHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/fefoBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_button"
            app:tint="@android:color/white"
            android:scaleType="fitCenter"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FEFO Review"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fefoHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/dmi_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/fefoMedicineNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#172033"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fefoRequestedQuantityText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#172033" />

                    <TextView
                        android:id="@+id/fefoEligibleStockText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#172033" />

                    <TextView
                        android:id="@+id/fefoReasonText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#738096" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PROPOSED FEFO ALLOCATION"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/fefoAllocationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@color/dmi_accent_light"
                android:padding="14dp"
                android:text="FEFO selects the earliest-expiring eligible stock first. No stock has been deducted yet."
                android:textColor="#31566D"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/overrideFefoButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Override FEFO Allocation"
                android:textColor="@color/dmi_outlined_text"
                android:visibility="gone"
                app:strokeColor="@color/dmi_outlined_stroke"
                app:cornerRadius="24dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/overrideSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/dmi_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FEFO OVERRIDE"
                        android:textColor="#B26A00"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Change the quantities only when there is a justified operational reason. The total must still equal the requested quantity."
                        android:textColor="#5F6878"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/overrideAllocationContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/overrideReasonLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Override reason"
                        app:boxStrokeColor="@color/dmi_input_stroke"
                        app:hintTextColor="@color/dmi_input_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/overrideReasonInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="4" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- confirmOverrideButton starts a user-requested change; the ViewModel or repository remains responsible for validation. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/confirmOverrideButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Confirm FEFO Override"
                        android:textColor="@color/dmi_primary_button_text"
                        app:backgroundTint="@color/dmi_primary_button_background" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelOverrideButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Use FEFO Recommendation"
                        android:textColor="@color/dmi_accent_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- confirmIssueProgress communicates that the screen is waiting for data or a submitted action. -->
            <ProgressBar
                android:id="@+id/confirmIssueProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/dmi_accent"
                android:progressTint="@color/dmi_accent"
                android:visibility="gone" />

            <!-- confirmIssueButton starts a user-requested change; the ViewModel or repository remains responsible for validation. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmIssueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Confirm Issue"
                android:textColor="@color/dmi_primary_button_text"
                app:backgroundTint="@color/dmi_primary_button_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="The issue is recorded locally first and then synchronised for authoritative cloud confirmation."
                android:textColor="#738096"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
