<?xml version='1.0' encoding='utf-8'?>
<!-- Layout for movement history. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/dmi_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- movementTypeText is referenced by the screen code when it renders or handles user input. -->
            <TextView
                android:id="@+id/movementTypeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stock Issued"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/movementQuantityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-40"
                android:textColor="@color/dmi_accent_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/movementMedicineText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#172033"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/movementBatchText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#738096"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/movementDateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#738096"
            android:textSize="13sp" />

        <!-- movementStatusText reflects the latest state returned to the screen. -->
        <TextView
            android:id="@+id/movementStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#31566D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/movementReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#5F6878"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/movementUserText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/movementSelectionHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tap to select as original operation"
            android:textColor="#31566D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
