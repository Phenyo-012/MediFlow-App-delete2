<?xml version="1.0" encoding="utf-8"?>
<!-- Layout for audit log. The Activity, Fragment or adapter uses these IDs to bind state and user actions. -->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- auditHeader is referenced by the screen code when it renders or handles user input. -->
    <LinearLayout
        android:id="@+id/auditHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dmi_accent"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/auditBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back_button"
            app:tint="@android:color/white"
            android:scaleType="fitCenter"  />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audit Log"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protected system activity"
                android:textColor="#EAF3FC"
                android:textSize="12sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auditRefreshButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="Refresh"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/dmi_primary"
            app:strokeColor="@android:color/white"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/auditOfflineNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#EAF3FC"
        android:padding="10dp"
        android:text="Audit history is cached locally for authorised offline viewing. Refresh requires a connection."
        android:textColor="#2D5C8A"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/auditHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- auditRefreshErrorText gives the user feedback when there is no content or an operation cannot complete. -->
    <TextView
        android:id="@+id/auditRefreshErrorText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="#A13C3C"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/auditOfflineNotice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- auditRecyclerView displays the current rows; its adapter supplies the values and click behavior. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/auditRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/auditRefreshErrorText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- auditProgress communicates that the screen is waiting for data or a submitted action. -->
    <ProgressBar
        android:id="@+id/auditProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/dmi_accent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/auditRefreshErrorText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/auditEmptyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="No audit records are available."
        android:textColor="#52677E"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/auditRefreshErrorText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
