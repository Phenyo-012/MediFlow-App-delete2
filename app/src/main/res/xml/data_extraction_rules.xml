<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude device-bound offline-session enrollment from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mediflow_offline_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mediflow_offline_session.xml"/>
    </device-transfer>
</data-extraction-rules>
